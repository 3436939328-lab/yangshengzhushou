<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.springbootdemo.dao.HealthQuestionnaireRecordDao">
  <resultMap id="BaseResultMap" type="org.example.springbootdemo.bean.HealthQuestionnaireRecord">
    <id column="id" property="id" jdbcType="BIGINT" />
    <result column="user_id" property="userId" jdbcType="BIGINT" />
    <result column="constitution_type" property="constitutionType" jdbcType="VARCHAR" />
    <result column="total_score" property="totalScore" jdbcType="INTEGER" />
    <result column="suggestion" property="suggestion" jdbcType="VARCHAR" />
    <result column="answers_json" property="answersJson" jdbcType="VARCHAR" />
    <result column="create_time" property="createTime" jdbcType="TIMESTAMP" />
  </resultMap>

  <select id="selectByUserId" resultMap="BaseResultMap">
    select id, user_id, constitution_type, total_score, suggestion, answers_json, create_time
    from health_questionnaire_record
    where user_id = #{userId,jdbcType=BIGINT}
    order by id desc
  </select>

  <insert id="insertSelective" parameterType="org.example.springbootdemo.bean.HealthQuestionnaireRecord" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
    insert into health_questionnaire_record
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="userId != null">user_id,</if>
      <if test="constitutionType != null">constitution_type,</if>
      <if test="totalScore != null">total_score,</if>
      <if test="suggestion != null">suggestion,</if>
      <if test="answersJson != null">answers_json,</if>
      <if test="createTime != null">create_time,</if>
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides=",">
      <if test="userId != null">#{userId,jdbcType=BIGINT},</if>
      <if test="constitutionType != null">#{constitutionType,jdbcType=VARCHAR},</if>
      <if test="totalScore != null">#{totalScore,jdbcType=INTEGER},</if>
      <if test="suggestion != null">#{suggestion,jdbcType=VARCHAR},</if>
      <if test="answersJson != null">#{answersJson,jdbcType=VARCHAR},</if>
      <if test="createTime != null">#{createTime,jdbcType=TIMESTAMP},</if>
    </trim>
  </insert>
</mapper>
